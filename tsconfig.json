{
  "extends": "polpo-typescript-config/vite",
  "include": ["vite.config.ts", "**/vite-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.json"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@contexts": ["./src/contexts"],
      "@core/*": ["./src/core/*"],
      "@helpers": ["./src/helpers"],
      "@hooks": ["./src/hooks"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
    },
  },
}
